<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasCustomerNumber">
    <rdfs:domain rdf:resource="http://purl.org/cerif/frapo/Purchaser"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
    <rdfs:label xml:lang="en">has customer number</rdfs:label>
    <rdfs:comment xml:lang="en">An identifying number for an agent, typically used by the accounting system of the supplier when issuing quotations, fulfilling orders and submitting invoices.</rdfs:comment>
    <vann:example>
    :my-purchaser a frapo:Purchaser ;
        frapo:hasCustomerNumber "CUST-44556" .
    </vann:example>
  </rdf:Description>
</rdf:RDF>

@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:unfunded a frapo:Status,
        owl:NamedIndividual ;
    rdfs:label "unfunded"@en ;
    vann:example """
    :my-application
        pso:holdsStatusInTime :my-status-in-time .
    
    :my-status-in-time a pso:StatusInTime ;
        pso:withStatus frapo:unfunded .
    """ ;
    rdfs:comment "The status of something such as an investigation or a project as being unfunded."@en ;
    rdfs:isDefinedBy frapo: ;
    vs:term_status reg:statusStable .


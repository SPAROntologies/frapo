      {
        "@language": "en",
        "@value": "has alternate name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/cerif/frapo/hasPersonalInformation"
      }

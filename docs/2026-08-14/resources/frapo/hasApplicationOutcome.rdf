<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasApplicationOutcome">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:comment xml:lang="en">The description of an outcome of an application, for example that a job has been offered or that a grant has been awarded.</rdfs:comment>
    <rdfs:label xml:lang="en">has application outcome</rdfs:label>
    <vann:example>
    :my-application 
        frapo:hasApplicationOutcome "Funded" .
    </vann:example>
  </rdf:Description>
</rdf:RDF>

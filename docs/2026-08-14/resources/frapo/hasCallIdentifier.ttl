@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:hasCallIdentifier a owl:DatatypeProperty ;
    rdfs:label "has call identifier"@en ;
    vann:example """
    :my-call-for-application 
        frapo:hasCallIdentifier "ERC-2026-STG" .
    """ ;
    rdfs:comment "The identifying number of a call for applications issued by a funding agency."@en ;
    rdfs:isDefinedBy frapo: ;
    rdfs:subPropertyOf dcterms:identifier ;
    vs:term_status reg:statusStable .


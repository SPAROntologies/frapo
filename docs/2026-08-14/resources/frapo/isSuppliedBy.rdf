<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/isSuppliedBy">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vann:example>
    :my-service 
        frapo:isSuppliedBy :my-supplier .

    :my-supplier a frapo:Supplier .
    </vann:example>
    <rdfs:label xml:lang="en">is supplied by</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:comment xml:lang="en">The relation between an entity that is supplied, or an agent to whom an entity is supplied, and the supplier.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/cerif/frapo/Supplier"/>
    <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/supplies"/>
  </rdf:Description>
</rdf:RDF>

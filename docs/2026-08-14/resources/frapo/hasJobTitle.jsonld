[
  {
    "@id": "http://purl.org/cerif/frapo/hasJobTitle",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-person a foaf:Person ;\n        frapo:hasJobTitle \"Associate Professor\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The job title held by a person, such as might appear next to the name in a directory or on a conference name badge. For example, the person's specific job title might be \"Linacre Professor of Zoology\" or \"Regius Professor of Moral Philosophy\". \n"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has job title"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/spar/scoro/withJobTitle"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/cerif/frapo/hasPersonalInformation"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "\nThis job title properly refers to the **role** held by that person (e.g. \"Head of Department\"), which can be separately defined using SCoRO, the Scholarly Contributions and Roles Ontology (http://purl.org/spar/scoro/).\n    "
      }
    ]
  }
]
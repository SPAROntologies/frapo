<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasFunderIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:label xml:lang="en">has funder identifer</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/cerif/frapo/FundingAgency"/>
    <rdfs:comment xml:lang="en">An identifier for a funding agency.</rdfs:comment>
    <vann:example>
    :my-funding-agency a frapo:FundingAgency ;
        frapo:hasFunderIdentifier "10.13039/501100000781" .
    </vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
  </rdf:Description>
</rdf:RDF>

<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/BudgetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A category of expenditure within a budget, determining what the allocated money can be spent on, for example salaries, equipment, travel.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-budget a frapo:Budget ;
        frapo:hasBudgetInformation :my-budgeted-amout .
    
    :my-budgeted-amount a frapo:BudgetedAmount ;
        frapo:hasBudgetCategory frapo:facilities-costs .

    frapo:facilities-costs a frapo:BudgetCategory .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/FinancialEntity"/>
    <rdfs:label xml:lang="en">budget category</rdfs:label>
  </rdf:Description>
</rdf:RDF>

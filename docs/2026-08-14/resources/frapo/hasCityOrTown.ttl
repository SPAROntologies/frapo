@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:hasCityOrTown a owl:DatatypeProperty ;
    rdfs:label "has city or town"@en ;
    vann:example """
    :my-event 
        frapo:hasCityOrTown "Bologna" .
    """ ;
    rdfs:comment "The specification of a city or town, for example as the location of an event."@en ;
    rdfs:isDefinedBy frapo: ;
    vs:term_status reg:statusStable .


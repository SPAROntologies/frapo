<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/GovernmentOrganization">
    <rdfs:comment xml:lang="en">An organization that is part of, or funded by, central or local goverment.</rdfs:comment>
    <rdfs:label xml:lang="en">government organization</rdfs:label>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-government-organization a frapo:GovernmentOrganization ;
        foaf:name "Ministry of Research" .
    </vann:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
  </rdf:Description>
</rdf:RDF>

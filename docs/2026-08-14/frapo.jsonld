    ]
  },
  {
    "@id": "http://purl.org/cerif/frapo/non-staff-costs",
    "@type": [
      "http://purl.org/cerif/frapo/BudgetCategory",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-budget a frapo:Budget ;\n        frapo:hasBudgetInformation :my-budgeted-amout .\n    \n    :my-budgeted-amount a frapo:BudgetedAmount ;\n        frapo:hasBudgetCategory frapo:non-staff-costs .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A budget category to cover all the costs associated with a project that do not involve the employment of staff by the institution, thus, for example, including consumables purchase, travel costs and consultancy fees, but excluding the salary, estates and indirect costs associated with the allocation of the PI's time to the project and the direct employment of a project manager."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "non-staff costs"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },

    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-funding-application \n        frapo:isEvaluatedBy :my-funding-agency .\n\n    :my-funding-agency a frapo:FundingAgency .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an entity and an agent that evaluates it."
      }
    ],

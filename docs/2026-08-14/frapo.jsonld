      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-application\n        pso:holdsStatusInTime :my-status-in-time .\n    \n    :my-status-in-time a pso:StatusInTime ;\n        pso:withStatus frapo:accepted .\n    "
      }
    ],

    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-vendor a frapo:Vendor ;\n        frapo:sellsTo :my-organization .\n    \n    :my-organization a foaf:Organization .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between a supplier and a purchaser to whom an entity is sold."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"

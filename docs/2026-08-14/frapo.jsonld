    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-account-statement \n        frapo:hasCurrency \"euro\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The currency used to specify a financial entity."
      }
    ],

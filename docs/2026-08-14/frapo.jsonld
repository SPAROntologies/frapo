      {
        "@value": "\n    :my-commitments a frapo:Commitments ;\n        frapo:hasCurrency \"EUR\" ; \n        frapo:hasValue \"45000\"^^xsd:decimal .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Money set aside to honour expenditures already made but for which no invoices have yet been received, or expenditures planned for the future, for example for salaries."
      }

    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-annual-turnover a frapo:AnnualTurnover ;\n        frapo:hasCurrency \"EUR\" ; \n        frapo:hasValue \"500000\"^^xsd:decimal .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The annual financial turnover of an organization (in a specified currency)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",

      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },
  {
    "@id": "http://purl.org/cerif/frapo/BudgetCategory",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-budget a frapo:Budget ;\n        frapo:hasBudgetInformation :my-budgeted-amout .\n    \n    :my-budgeted-amount a frapo:BudgetedAmount ;\n        frapo:hasBudgetCategory frapo:facilities-costs .\n\n    frapo:facilities-costs a frapo:BudgetCategory .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A category of expenditure within a budget, determining what the allocated money can be spent on, for example salaries, equipment, travel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "budget category"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.org/cerif/frapo/FinancialEntity"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },
  {
    "@id": "http://purl.org/cerif/frapo/Quotation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-quotation a frapo:Quotation ;\n        frapo:hasMonetaryValue \"10000000\"^^xsd:decimal ; \n        frapo:hasCurrency \"EUR\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\nA formal statement of promise (usually provided in response to a request for quotation) by potential supplier to supply goods or services at specified prices and within a specified period. Acceptance of the quotation by the buyer constitutes an agreement binding on both parties.\n"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "quotation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.businessdictionary.com/definition/quotation.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.org/cerif/frapo/FinancialEntity"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },
  {
    "@id": "http://purl.org/cerif/frapo/hasORCID",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-person a foaf:Person ;\n        frapo:hasORCID \"0000-0003-0530-4305\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",

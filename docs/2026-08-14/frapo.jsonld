      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },
  {
    "@id": "http://purl.org/cerif/frapo/AccountStatement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n\t:my-account-statement a frapo:AccountStatement ;\n        frapo:hasMonetaryValue \"5000\"^^xsd:decimal ; \n        frapo:hasCurrency \"EUR\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A statement of income and expenditure for an account, typically presented as dated income receipts and outgoings against categories in a budget for that account."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/cerif/frapo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "account statement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.org/cerif/frapo/FinancialEntity"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },

        "@value": "\n    :my-stipend a frapo:Stipend ;\n        frapo:hasMonetaryValue \"2800\"^^xsd:decimal ; \n        frapo:hasCurrency \"EUR\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [

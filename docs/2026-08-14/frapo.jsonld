    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-postal-address \n        frapo:hasPostCode \"40126\" .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The postal code of an address."

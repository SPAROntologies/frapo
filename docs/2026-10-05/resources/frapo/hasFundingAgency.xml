<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasFundingAgency">
    <rdfs:range rdf:resource="http://purl.org/cerif/frapo/FundingAgency"/>
    <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/isFundingAgencyFor"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:comment xml:lang="en">The relation between something and a funding agency that provides funding for it.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-project 
        frapo:hasFundingAgency :my-funding-agency .

    :my-funding-agency a frapo:FundingAgency .
    </vann:example>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/cerif/frapo/isSupportedBy"/>
    <rdfs:label xml:lang="en">has funding agency</rdfs:label>
  </rdf:Description>
</rdf:RDF>

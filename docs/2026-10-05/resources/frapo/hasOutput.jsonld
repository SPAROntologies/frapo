    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an activity such as a project or endeavour and something that is created or produced as a result of that activity. Examples include a building created as a result of a building project, and a journal article published to describe the results of a research investigation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [

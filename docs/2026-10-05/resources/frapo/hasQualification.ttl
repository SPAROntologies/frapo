@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:hasQualification a owl:DatatypeProperty ;
    rdfs:label "has qualification"@en ;
    vann:example """
    :my-person 
        frapo:hasQualification "Doctor of Philosophy in Computer Science" .
    """ ;
    rdfs:comment "The qualification held by a person."@en ;
    rdfs:isDefinedBy frapo: ;
    rdfs:subPropertyOf frapo:hasPersonalInformation ;
    vs:term_status reg:statusStable .


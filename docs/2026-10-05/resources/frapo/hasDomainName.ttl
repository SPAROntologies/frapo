@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:hasDomainName a owl:DatatypeProperty ;
    rdfs:label "has domain name"@en ;
    vann:example """
    :my-university 
        frapo:hasDomainName "unibo.it" .
    """ ;
    rdfs:comment "An internet domain name that has been registered for an entity, for example http://www.miidi.org for MIIDI, the Minimal Information standard for reporting an Infectious Disease Investigation."@en ;
    rdfs:isDefinedBy frapo: ;
    vs:term_status reg:statusStable .


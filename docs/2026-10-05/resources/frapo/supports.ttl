@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    vann:example """
    :my-grant a frapo:Grant ;
        frapo:supports :my-project .
    """ ;
    rdfs:comment "The relation between an agent and something that the agent supports by financial or other means."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( frapo:Funding foaf:Agent ) ] ;
    rdfs:isDefinedBy frapo: ;
    vs:term_status reg:statusStable ;
    skos:note "This property is not intended for use to describe mechanical or physical support, as in \"The plinth supports the statue\". "@en .


    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an agent and something for which that agent applies, for example a job, membership of an organization, or a grant from a funding agency."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {

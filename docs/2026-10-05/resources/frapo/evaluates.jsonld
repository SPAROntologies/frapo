[
  {
    "@id": "http://purl.org/cerif/frapo/evaluates",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-funding-agency a frapo:FundingAgency ;\n        frapo:evaluates :my-funding-application .\n    \n    :my-funding-application a frapo:FundingApplication .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an agent and an entity which that agent evaluates, for example a funding agency that is evaluating a grant application to determine whether the proposed project is worthy of funding, or a publisher evaluating a manuscript to determine whether it is suitable for publication."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"
      }
    ],

  <rdf:Description rdf:about="http://purl.org/cerif/frapo/usesFacility">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">The relation between an activity such as an expedition, a research project or an investigation, and a facility employed in that activity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <vann:example>
    :my-project 
        frapo:usesFacility :my-facility .

    :my-facility a frapo:Facility .
    </vann:example>
    <rdfs:range rdf:resource="http://purl.org/cerif/frapo/Facility"/>
    <rdfs:label xml:lang="en">uses facility</rdfs:label>

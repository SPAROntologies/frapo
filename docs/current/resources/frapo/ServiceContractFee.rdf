<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/ServiceContractFee">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/Fee"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vann:example>
    :my-service-contract-fee a frapo:ServiceContractFee ;
        frapo:hasMonetaryValue "8000"^^xsd:decimal ; 
        frapo:hasCurrency "EUR" .
    </vann:example>
    <rdfs:comment xml:lang="en">A fee paid periodically, typically annually, to obtain access when required to a service such as an equipment maintenance contract."</rdfs:comment>
    <rdfs:label xml:lang="en">service contract fee</rdfs:label>
  </rdf:Description>
</rdf:RDF>

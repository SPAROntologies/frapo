@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

frapo:GovernmentOrganization a owl:Class ;
    rdfs:label "government organization"@en ;
    vann:example """
    :my-government-organization a frapo:GovernmentOrganization ;
        foaf:name "Ministry of Research" .
    """ ;
    rdfs:comment "An organization that is part of, or funded by, central or local goverment."@en ;
    rdfs:isDefinedBy frapo: ;
    rdfs:subClassOf foaf:Organization ;
    vs:term_status reg:statusStable .


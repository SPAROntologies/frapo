<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/isManufacturedBy">
    <rdfs:range rdf:resource="http://purl.org/cerif/frapo/Manufacturer"/>
    <rdfs:label xml:lang="en">is manufactured by</rdfs:label>
    <rdfs:comment xml:lang="en">The relation between a manufactured entity and its manufacturer.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/manufactures"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vann:example>
    :my-equipment 
        frapo:isManufacturedBy :my-manufacturer .
    
    :my-manufacturer a frapo:Manufacturer .
    </vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
</rdf:RDF>

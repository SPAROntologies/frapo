<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasProjectIdentifier">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
    <rdfs:comment xml:lang="en">An identifier for a project.</rdfs:comment>
    <rdfs:label xml:lang="en">has project identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Project"/>
    <vann:example>
    :my-project a foaf:Project ;
        frapo:hasProjectIdentifier "PRJ-2026-01" .
    </vann:example>
  </rdf:Description>
</rdf:RDF>

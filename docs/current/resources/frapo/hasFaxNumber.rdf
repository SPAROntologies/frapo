    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:label xml:lang="en">has fax number</rdfs:label>
    <rdfs:comment xml:lang="en">A fax number for an agent.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>

>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasFaxNumber">
    <vann:example>
    :my-organization a foaf:Organization ;
        frapo:hasFaxNumber "+39-051-123456" .
    </vann:example>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/cerif/frapo/hasAgentInformation"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>

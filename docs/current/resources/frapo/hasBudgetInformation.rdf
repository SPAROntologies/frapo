<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasBudgetInformation">
    <rdfs:label xml:lang="en">has budget information</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/cerif/frapo/BudgetInformation"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/cerif/frapo/"/>
    <rdfs:comment xml:lang="en">The relation between a budget and some piece of information describing it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/cerif/frapo/Budget"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example xml:lang="en">
    :my-budget a frapo:Budget ;
        frapo:hasBudgetInformation :travel-budgeted .
    
    :travel-budgeted a frapo:BudgetInformation .
    </vann:example>
  </rdf:Description>
</rdf:RDF>
